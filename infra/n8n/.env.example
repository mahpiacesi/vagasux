# Copy to .env and fill before first run:
#   cp .env.example .env

# Pin a version after first successful deploy (optional).
N8N_VERSION=1.123.4

# Local port exposed on the VPS (reverse proxy usually terminates TLS).
N8N_BIND_PORT=5678

# Public URL (update when DNS is ready).
N8N_HOST=n8n.vagasux.com.br
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.vagasux.com.br/

GENERIC_TIMEZONE=America/Sao_Paulo

# Generate once and store in a password manager — never change after credentials exist.
# openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Postgres (internal to this stack — not Supabase).
POSTGRES_USER=n8n_admin
POSTGRES_PASSWORD=
POSTGRES_DB=n8n
POSTGRES_NON_ROOT_USER=n8n
POSTGRES_NON_ROOT_PASSWORD=

N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_SECURE_COOKIE=true
