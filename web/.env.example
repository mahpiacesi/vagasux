VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Server-only variables for the Mentoria form. Never prefix these with VITE_.
N8N_MENTORSHIP_REQUEST_WEBHOOK_URL=https://n8n.example.com/webhook/mentorship-request-intake
N8N_MENTOR_APPLICATION_WEBHOOK_URL=https://n8n.example.com/webhook/mentor-application-intake
MENTORSHIP_PROOF_UPLOAD_URL=https://YOUR_PROJECT.supabase.co/functions/v1/upload-mentorship-proof
MENTORSHIP_UPLOAD_SECRET=replace-with-a-random-secret

# Analytics (optional — loaded only after cookie consent)
VITE_CLARITY_PROJECT_ID=your_clarity_project_id

# Google Analytics — loaded only after cookie consent
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional AdSense display unit. The publisher id is in the site code.
# Create a responsive display unit in AdSense and paste its data-ad-slot here.
# VITE_ADSENSE_AD_SLOT=0000000000
