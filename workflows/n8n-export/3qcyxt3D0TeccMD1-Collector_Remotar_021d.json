    {
      "id": "8c6f2f4e-c95c-4fc5-877e-088836cf5d21",
      "name": "Map and dedupe Remotar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        192
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const SKIP_SOURCES = new Set(['gupy', 'solides', 'trampos']);\nconst MAX_AGE_MS = 60 * 24 * 60 * 60 * 1000;\nconst byId = new Map();\nfor (const item of items) {\n  const rows = Array.isArray(item.json?.data) ? item.json.data : [];\n  for (const job of rows) {\n    if (!job?.id) continue;\n    byId.set(String(job.id), job);\n  }\n}\nfunction hostOf(url) {\n  try { return new URL(url).hostname.toLowerCase(); } catch { return ''; }\n}\nfunction stripHtml(html) {\n  return String(html || '').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\n}\nconst out = [];\nfor (const job of byId.values()) {\n  const integration = String(job.integrationSource || '').toLowerCase();\n  const external = String(job.externalLink || '').trim();\n  const externalHost = hostOf(external);\n  let skipReason = null;\n  if (SKIP_SOURCES.has(integration)) skipReason = 'covered_by_' + integration;\n  else if (externalHost.includes('gupy.io')) skipReason = 'external_gupy';\n  else if (externalHost.includes('solides')) skipReason = 'external_solides';\n  else if (externalHost.includes('trampos.co')) skipReason = 'external_trampos';\n  const publishedAt = job.createdAt || job.updatedAt || null;\n  const publishedMs = publishedAt ? new Date(publishedAt).getTime() : NaN;\n  const withinAge = Number.isNaN(publishedMs) ? true : (Date.now() - publishedMs) <= MAX_AGE_MS;\n  if (!withinAge) skipReason = skipReason || 'older_than_60_days';\n  const company = (job.company && job.company.name) || job.companyDisplayName || 'Empresa ocultada';\n  const title = String(job.title || '').trim();\n  if (!title) continue;\n  const remotarUrl = 'https://remotar.com.br/job/' + job.id;\n  const location = job.type === 'remote'\n    ? 'Remota'\n    : [job.city, job.state].filter(Boolean).join(', ') || 'Remota';\n  out.push({\n    json: {\n      source: 'Remotar',\n      source_job_id: String(job.id),\n      company: String(company).trim(),\n      title,\n      description: stripHtml(job.description) || null,\n      url: remotarUrl,\n      location,\n      published_at: publishedAt,\n      integration_source: integration || null,\n      skip: Boolean(skipReason),\n      skip_reason: skipReason,\n    },\n  });\n}\nreturn out;"
      }
    },
