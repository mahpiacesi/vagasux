              "type": "string",
              "value": "={{ $json.workplaceType === 'remote' ? 'Remota' : [$json.city, $json.state, $json.country].filter(Boolean).join(', ') }}"
            },
            {
              "id": "1141f50a-23e2-473b-9c6a-9ba8ca35a72e",
              "name": "source",
              "type": "string",
              "value": "Gupy"
